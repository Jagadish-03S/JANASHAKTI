# ==========================================
# JANASHAKTI ENVIRONMENT CONFIGURATION (ROOT)
# Pilot Deployment: Davanagere, Karnataka, India
# ==========================================

NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# PostgreSQL / PostGIS Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=janashakti_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_SSL=false

# Security & Authentication
JWT_SECRET=janashakti_pilot_secret_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Geolocation Pilot Defaults (Davanagere City Corporation)
PILOT_CITY_NAME=Davanagere
PILOT_LATITUDE=14.4644
PILOT_LONGITUDE=75.9218
PUBLIC_LOCATION_JITTER_METERS=100

# Microservices
AI_SERVICE_URL=http://localhost:8000
FCM_SERVER_KEY=mock_or_fcm_service_account_key

